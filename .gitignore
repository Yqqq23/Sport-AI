# --- Model weights -------------------------------------------------------
# Never commit weights. They are large, and the only ones available locally are
# generic COCO checkpoints that this project does not use. Self-trained weights
# are produced on the GPU server and stay there.
*.pt
*.pth
*.onnx
*.engine
*.torchscript

# Cached ImageNet backbone weights: downloaded once into the checkout so the
# GPU server trains fully offline. Reproducible from torchvision, so not
# versioned - but it must be copied to the server alongside the code.
.torch_home/
checkpoints/

# --- Datasets ------------------------------------------------------------
datasets/
train/datasets/
# Written by scripts/gen_synthetic.py and the SVHN / SoccerNet downloaders.
# All regenerable; the debug contact sheets are review artifacts, not source.
data/synthetic/
data/svhn/
data/soccernet/
data/debug/
*.mp4
*.avi
*.mov
*.mkv

# --- Run outputs ---------------------------------------------------------
outputs/
runs/
*.log

# --- Annotation tool runtime state ---------------------------------------
# tools/annotation writes uploaded videos, extracted frames and exported
# datasets under tools/annotation/data/, and its SQLite DB next to the backend.
# Both are per-machine working state, not source.
tools/annotation/data/
tools/annotation/frontend/node_modules/
*.db
*.sqlite3

# --- Secrets -------------------------------------------------------------
.env
.env.*
!.env.example
!.env.server.example

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
