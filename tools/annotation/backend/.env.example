APP_NAME=jersey-active-learning
APP_ENV=development
DATABASE_URL=sqlite:///./jersey_active_learning.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATA_DIR=../data

# ============================================================
# Pipeline: Upload -> ffmpeg transcode -> OpenCV frame extraction
#           -> YOLOv8n player detection -> Tesseract OCR (jersey #)
#           -> InsightFace face clustering (track_id assignment)
#           -> Active learning candidates (low conf + temporal inconsistency)
#           -> Manual annotation -> Dataset export (COCO/YOLO/internal)
# ============================================================

# ============================================================
# Recognition settings
# ============================================================
REAL_RECOGNITION_ENABLED=true
DETECTOR_CONFIDENCE=0.2
DETECTOR_IOU=0.45
RECOGNITION_FRAME_STRIDE=5

# ============================================================
# (Optional) Sport-CV root — only needed for fixed7 dry-run
# ============================================================
# SPORT_CV_ROOT=../../Sport-CV